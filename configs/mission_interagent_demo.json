{
  "id": "peer_exchange",
  "goal": "Show inter-agent messaging: architect hands a note to the reviewer.",
  "owner_llm": "example",
  "max_workers": 3,
  "agent_timeout_seconds": 60,
  "sandbox": {"allowlist": ["python3"], "cpu_seconds": 20, "wall_seconds": 30, "memory_mb": 512},
  "agents": [
    {
      "id": "architect",
      "role": "Draft a plan and message the reviewer.",
      "steps": [{"label": "draft", "command": ["python3", "-c", "print('architecture drafted')"]}],
      "messages": [{"to": "reviewer", "kind": "review_request", "body": "Please review the WW2 scene plan."}]
    },
    {
      "id": "reviewer",
      "role": "Receive the architect's message after it finishes.",
      "depends_on": ["architect"],
      "steps": [{"label": "ack", "command": ["python3", "-c", "print('reviewing')"]}]
    }
  ]
}
