{
  "id": "demo_pipeline",
  "goal": "Plan a short 3D animation scene, gather notes, and review them — as sandboxed agents.",
  "owner_llm": "example",
  "max_workers": 3,
  "agent_timeout_seconds": 60,
  "sandbox": {
    "allowlist": ["python3", "python"],
    "cpu_seconds": 20,
    "wall_seconds": 30,
    "memory_mb": 512
  },
  "agents": [
    {
      "id": "planner",
      "role": "Write the scene plan to the shared handoff folder.",
      "steps": [
        {"label": "write-plan",
         "command": ["python3", "-c", "import os;open(os.path.join(os.environ['CEREX_SHARED'],'plan.txt'),'w').write('Scene: WW2 beach landing, 3 shots')"]}
      ]
    },
    {
      "id": "researcher",
      "role": "Produce reference notes in its own workspace.",
      "steps": [
        {"label": "notes", "command": ["python3", "-c", "open('notes.txt','w').write('Reference: lighting, haze, camera shake')"]}
      ]
    },
    {
      "id": "reviewer",
      "role": "Read the shared plan and summarize once dependencies are done.",
      "depends_on": ["planner", "researcher"],
      "steps": [
        {"label": "review",
         "command": ["python3", "-c", "import os;print('Reviewed plan:',open(os.path.join(os.environ['CEREX_SHARED'],'plan.txt')).read())"]}
      ]
    }
  ]
}
